# Copy this file to .env and adjust as needed.
# Defaults here are for local development against the SQL Server instance
# already installed on this machine (see docs/database-setup.md) — never use
# these values, or a committed .env, in any real/shared environment.

# ---- General ----
NODE_ENV=development

# ---- API server (apps/api) ----
PORT=3000
CORS_ORIGIN=http://localhost:5173

# ---- Frontend (apps/web) ----
VITE_API_BASE_URL=http://localhost:3000/api
# Phases 1-5 (DB + backend API) are built, so the frontend defaults to the
# real HttpApiClient. Set this to true to fall back to the in-memory mock API
# client instead (e.g. offline work, or no local SQL Server running).
VITE_USE_MOCK_API=false

# ---- Auth ----
JWT_SECRET=change-me-in-real-use
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-too
JWT_REFRESH_EXPIRES_IN=7d

# ---- SQL Server (local instance already installed on this machine) ----
# See docs/database-setup.md for one-time setup: enabling SQL Server
# Authentication + TCP/IP, and creating the login/database below.
DB_HOST=localhost
# For a named instance (e.g. SQL Server Express) use: localhost\SQLEXPRESS
DB_PORT=1433
DB_NAME=pw_books
DB_USER=pw_books_app
DB_PASSWORD=YourStrong!Passw0rd
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
